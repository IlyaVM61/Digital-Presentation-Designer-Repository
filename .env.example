# Шаблон переменных окружения. Скопируйте в `.env` и заполните.
# Файл `.env` в репозиторий не попадает — в нём секреты.
#
#   cp .env.example .env
#
# Проверка доступа к провайдеру:
#   D:\venvs\dpd\Scripts\python scripts/check_provider.py

# --- Модели -----------------------------------------------------------------
# Провайдер выбран 2026-09-29: OpenRouter. Обоснование состава — в MODELS.md.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b

# VLM для недетерминированного аудита. Qwen2.5-VL на OpenRouter отсутствует;
# единственный доступный там 72B нарушает лимит ТЗ в 35B.
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=qwen/qwen3-vl-32b-instruct

# Генерация изображений исключена из объёма решением D7.
T2I_ENABLED=false
T2I_MODEL=black-forest-labs/FLUX.1-schnell

# --- Окружение --------------------------------------------------------------
# Пути — с машины разработки, где на системном диске мало места.
# Подставьте свои: код этих путей не знает.
SOFFICE_PATH=D:\LibreOffice\program\soffice.com
DPD_OUTPUT_DIR=D:\dpd-out

# --- Прогон -----------------------------------------------------------------
PIPELINE_TIMEOUT_SEC=300
LOG_LEVEL=INFO
